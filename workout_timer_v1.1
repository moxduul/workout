<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>Workout Timer v1.1</title>
  <style>
    :root {
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      color-scheme: dark;
    }
    body {
      margin: 0;
      background: #0b0c10;
      color: #e8e8ea;
      padding: 16px;
      padding-bottom: calc(16px + env(safe-area-inset-bottom));
    }
    .app { max-width: 980px; margin: 0 auto; display: grid; gap: 14px; }
    h1 { font-size: 18px; margin: 0; font-weight: 750; letter-spacing: -0.2px; }

    .card {
      background: #12141b;
      border: 1px solid #222635;
      border-radius: 14px;
      padding: 14px;
      box-shadow: 0 6px 18px rgba(0,0,0,.25);
    }

    .grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 14px; }
    @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }

    textarea {
      width: 100%;
      min-height: 240px;
      resize: vertical;
      background: #0f1117;
      color: #e8e8ea;
      border: 1px solid #23283a;
      border-radius: 12px;
      padding: 12px;
      outline: none;
      line-height: 1.35;
      font-size: 14px;
    }

    .row { display:flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; }
    .row.left { justify-content: flex-start; }
    .label { font-size: 12px; opacity: .75; text-transform: uppercase; letter-spacing: .06em; }
    .hint { font-size: 13px; opacity: .82; line-height: 1.45; margin-top: 6px; }

    button {
      background: #1f6feb;
      color: #fff;
      border: 0;
      padding: 10px 12px;
      border-radius: 12px;
      cursor: pointer;
      font-weight: 750;
      font-size: 14px;
    }
    button.secondary { background: #2a2f40; }
    button.danger { background: #d73a49; }
    button:disabled { opacity: .5; cursor: not-allowed; }

    .bigTime { font-variant-numeric: tabular-nums; font-size: 54px; font-weight: 900; letter-spacing: -1px; }
    .desc { font-size: 18px; font-weight: 750; margin-top: 6px; line-height: 1.35; }
    .sub { opacity: .82; font-size: 13px; margin-top: 6px; }

    .progressWrap { margin-top: 12px; }
    .bar {
      height: 10px;
      border-radius: 999px;
      background: #1b1f2b;
      overflow: hidden;
      border: 1px solid #262c3f;
    }
    .fill { height: 100%; width: 0%; background: #1f6feb; }

    .mini { font-size: 13px; opacity: .85; margin-top: 8px; display:flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; }

    .list {
      max-height: 260px;
      overflow: auto;
      border-top: 1px solid #222635;
      margin-top: 12px;
      padding-top: 12px;
    }
    .seg {
      display: grid;
      grid-template-columns: 74px 1fr;
      gap: 10px;
      padding: 8px 10px;
      border-radius: 12px;
      border: 1px solid transparent;
    }
    .seg.active { border-color: #1f6feb; background: rgba(31,111,235,.12); }
    .seg .t { font-variant-numeric: tabular-nums; opacity: .9; }
    .seg .d { opacity: .95; }

    /* Workout Mode (phone-first) */
    .workoutMode .editorCard { display: none; }
    .workoutMode .grid { grid-template-columns: 1fr; }
    .workoutMode body, body.workoutMode { padding: 10px; padding-bottom: calc(10px + env(safe-area-inset-bottom)); }

    .workoutMode .desc {
      font-size: clamp(18px, 3.4vw, 26px);
      font-weight: 850;
      letter-spacing: -0.2px;
    }
    .workoutMode .bigTime {
      font-size: clamp(64px, 12vw, 110px);
      line-height: 1;
    }

    .controlsBig {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 12px;
    }
    .controlsBig button {
      padding: 14px 14px;
      font-size: 18px;
      border-radius: 16px;
    }
    .controlsSmall {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
      margin-top: 10px;
    }
    .controlsSmall button {
      padding: 12px 12px;
      font-size: 16px;
      border-radius: 16px;
    }

    .toggles {
      display:flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 10px;
      align-items: center;
    }
    .toggle {
      display:flex;
      gap: 8px;
      align-items: center;
      font-size: 13px;
      opacity: .9;
      user-select: none;
    }
    input[type="checkbox"] { transform: translateY(1px) scale(1.05); }

    .pill {
      display:inline-flex;
      align-items:center;
      gap: 8px;
      padding: 8px 10px;
      border-radius: 999px;
      background: #0f1117;
      border: 1px solid #23283a;
    }

    .topActions { display:flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    @media (max-width: 520px) {
      .topActions { justify-content: flex-start; }
      textarea { min-height: 210px; }
    }
  </style>
</head>

<body>
  <div class="app">
    <div class="row">
      <h1>Workout Timer <span style="opacity:.75;font-weight:700;">v1.1</span></h1>

      <div class="topActions">
        <span class="pill toggle" title="Hide editor and show big workout controls">
          <input type="checkbox" id="modeToggle" />
          Workout mode
        </span>
        <button id="demoBtn" class="secondary">Use example</button>
      </div>
    </div>

    <div class="grid">
      <div class="card editorCard">
        <div class="row">
          <div>
            <div class="label">Workout description</div>
            <div class="hint">
              Paste from intervals.icu. Intervals must start with durations like <code>9m20s</code>, <code>15m</code>, <code>30s</code>.
              Repeat headers like <code>Main set 3x</code> repeat the following interval block.
            </div>
          </div>
          <div class="row left">
            <button id="loadBtn">Load</button>
            <button id="clearBtn" class="danger">Clear</button>
          </div>
        </div>
        <textarea id="input" placeholder="Paste your workout here..."></textarea>
      </div>

      <div class="card">
        <div class="label">Now</div>
        <div id="segmentDesc" class="desc">Load a workout to begin.</div>

        <div style="margin-top: 12px;">
          <div class="label">Countdown to next interval</div>
          <div id="countdown" class="bigTime">00:00</div>
          <div class="sub" id="metaLine"></div>
        </div>

        <div class="controlsBig">
          <button id="playBtn" disabled>Play</button>
          <button id="nextBtn" class="secondary" disabled>Next</button>
        </div>

        <div class="controlsSmall">
          <button id="prevBtn" class="secondary" disabled>Prev</button>
          <button id="resetBtn" class="danger" disabled>Reset</button>
          <button id="reloadBtn" class="secondary" disabled>Reload</button>
        </div>

        <div class="toggles">
          <label class="toggle"><input type="checkbox" id="beepToggle" checked /> Beep on change</label>
          <label class="toggle"><input type="checkbox" id="countdownBeepToggle" /> 3-2-1 beeps</label>
          <label class="toggle"><input type="checkbox" id="vibrateToggle" checked /> Vibrate</label>
          <label class="toggle"><input type="checkbox" id="wakeLockToggle" /> Keep screen awake</label>
        </div>

        <div class="progressWrap">
          <div class="bar"><div id="fill" class="fill"></div></div>
          <div class="mini">
            <div id="posInfo">—</div>
            <div id="totalInfo">—</div>
          </div>
        </div>

        <div class="list" id="segmentsList"></div>
      </div>
    </div>
  </div>

<script>
(() => {
  /** -------------------- Storage -------------------- **/
  const STORAGE_KEY = "workout_timer_v1_1";
  function saveState(partial) {
    const current = loadState();
    const merged = { ...current, ...partial };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(merged));
  }
  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch {
      return {};
    }
  }

  /** -------------------- Parsing -------------------- **/
  function parseDurationMs(candidate) {
    const t = candidate.trim().toLowerCase();
    let hours = 0, mins = 0, secs = 0;

    const h = t.match(/(\d+)\s*h/);
    const m = t.match(/(\d+)\s*m/);
    const s = t.match(/(\d+)\s*s/);
    if (h) hours = parseInt(h[1], 10);
    if (m) mins = parseInt(m[1], 10);
    if (s) secs = parseInt(s[1], 10);

    const ms = ((hours * 3600) + (mins * 60) + secs) * 1000;
    return ms > 0 ? ms : null;
  }

  function extractLeadingDuration(line) {
    const trimmed = line.trim();
    if (!trimmed) return null;

    // Try first 1..4 tokens as the duration spec (supports "9m20s", "9m 20s", "1h 2m 3s")
    const parts = trimmed.split(/\s+/);
    let best = null;
    for (let k = 1; k <= Math.min(4, parts.length); k++) {
      const candidate = parts.slice(0, k).join(" ");
      const ms = parseDurationMs(candidate);
      if (ms != null) best = { ms, usedTokens: k };
    }
    if (!best) return null;

    return {
      ms: best.ms,
      rest: parts.slice(best.usedTokens).join(" ").trim(),
      usedTokens: best.usedTokens,
    };
  }

  function isRepeatHeader(line) {
    const m = line.trim().match(/^(.*)\b(\d+)\s*x\s*$/i);
    if (!m) return null;
    const label = (m[1] || "").trim() || "Repeat";
    const count = parseInt(m[2], 10);
    if (!Number.isFinite(count) || count <= 1) return null;
    return { label, count };
  }

  function isNonIntervalHeader(line) {
    const t = line.trim();
    if (!t) return false;
    return extractLeadingDuration(t) === null;
  }

  function parseWorkout(text) {
    const lines = text
      .split(/\r?\n/)
      .map(l => l.trim())
      .filter(l => l.length > 0);

    const out = [];
    let i = 0;

    while (i < lines.length) {
      const line = lines[i];

      const rep = isRepeatHeader(line);
      if (rep) {
        // Collect the following interval block until next header/non-interval line
        const block = [];
        i++;

        while (i < lines.length) {
          const candidateLine = lines[i];
          const dur = extractLeadingDuration(candidateLine);
          if (!dur) break; // stop at next header
          block.push({
            durationMs: dur.ms,
            displayText: candidateLine.trim(), // FULL LINE as description ✅
            rest: dur.rest,
            section: rep.label,
          });
          i++;
        }

        for (let r = 1; r <= rep.count; r++) {
          for (const seg of block) {
            out.push({
              durationMs: seg.durationMs,
              displayText: seg.displayText,
              rest: seg.rest,
              section: `${rep.label} (${r}/${rep.count})`
            });
          }
        }
        continue;
      }

      const dur = extractLeadingDuration(line);
      if (dur) {
        out.push({
          durationMs: dur.ms,
          displayText: line.trim(), // FULL LINE as description ✅
          rest: dur.rest,
          section: null
        });
        i++;
        continue;
      }

      // Header label applies to subsequent direct intervals until next header/repeat header
      const header = line.trim();
      i++;
      while (i < lines.length) {
        const next = lines[i];
        if (isRepeatHeader(next) || isNonIntervalHeader(next)) break;

        const d = extractLeadingDuration(next);
        if (!d) break;

        out.push({
          durationMs: d.ms,
          displayText: next.trim(), // FULL LINE ✅
          rest: d.rest,
          section: header
        });
        i++;
      }
    }

    if (out.length === 0) {
      throw new Error("No intervals found. Make sure lines start with durations like '9m20s ...'.");
    }
    return out;
  }

  /** -------------------- Player -------------------- **/
  const els = {
    input: document.getElementById("input"),
    loadBtn: document.getElementById("loadBtn"),
    clearBtn: document.getElementById("clearBtn"),
    demoBtn: document.getElementById("demoBtn"),

    playBtn: document.getElementById("playBtn"),
    prevBtn: document.getElementById("prevBtn"),
    nextBtn: document.getElementById("nextBtn"),
    resetBtn: document.getElementById("resetBtn"),
    reloadBtn: document.getElementById("reloadBtn"),

    segmentDesc: document.getElementById("segmentDesc"),
    countdown: document.getElementById("countdown"),
    metaLine: document.getElementById("metaLine"),
    fill: document.getElementById("fill"),
    posInfo: document.getElementById("posInfo"),
    totalInfo: document.getElementById("totalInfo"),
    list: document.getElementById("segmentsList"),

    modeToggle: document.getElementById("modeToggle"),
    beepToggle: document.getElementById("beepToggle"),
    countdownBeepToggle: document.getElementById("countdownBeepToggle"),
    vibrateToggle: document.getElementById("vibrateToggle"),
    wakeLockToggle: document.getElementById("wakeLockToggle"),
  };

  const DEMO = `Warmup

9m20s 50-75% (75-112w) FTP
Main set 3x

15m 90% (135w) FTP
5m 55% (82w) FTP
Cooldown

9m20s 50% (75w) FTP`;

  let segments = [];
  let idx = 0;
  let running = false;

  let segRemainingMs = 0;
  let lastTick = 0;

  let totalMs = 0;
  let elapsedBeforeCurrentMs = 0;

  // Countdown beeps state
  let lastSecondAnnounced = null;

  function formatMMSS(ms) {
    const clamped = Math.max(0, Math.ceil(ms / 1000));
    const mm = Math.floor(clamped / 60);
    const ss = clamped % 60;
    return String(mm).padStart(2, "0") + ":" + String(ss).padStart(2, "0");
  }

  function sumTotalMs(segs) {
    return segs.reduce((a, s) => a + s.durationMs, 0);
  }
  function computeElapsedBeforeIndex(segs, index) {
    let s = 0;
    for (let i = 0; i < index; i++) s += segs[i].durationMs;
    return s;
  }

  // Simple beep using WebAudio
  function beep(freq = 880, ms = 110) {
    if (!els.beepToggle.checked) return;
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.frequency.value = freq;
      gain.gain.value = 0.05;
      osc.start();
      setTimeout(() => { osc.stop(); ctx.close(); }, ms);
    } catch (_) {}
  }

  function vibrate(pattern) {
    if (!els.vibrateToggle.checked) return;
    if (navigator.vibrate) {
      try { navigator.vibrate(pattern); } catch (_) {}
    }
  }

  // Wake Lock
  let wakeLock = null;
  async function setWakeLock(on) {
    if (!("wakeLock" in navigator)) {
      // Not supported (e.g., iOS Safari)
      els.wakeLockToggle.checked = false;
      saveState({ wakeLock: false });
      return;
    }
    try {
      if (on) {
        wakeLock = await navigator.wakeLock.request("screen");
        wakeLock.addEventListener("release", () => { wakeLock = null; });
      } else if (wakeLock) {
        await wakeLock.release();
        wakeLock = null;
      }
    } catch (_) {
      // silently fail
      els.wakeLockToggle.checked = false;
      saveState({ wakeLock: false });
    }
  }

  document.addEventListener("visibilitychange", () => {
    // If the page becomes visible again, re-acquire wake lock if user wants it and we are running
    if (document.visibilityState === "visible" && els.wakeLockToggle.checked && running) {
      setWakeLock(true);
    }
  });

  function escapeHtml(str) {
    return String(str)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function renderList() {
    els.list.innerHTML = "";
    segments.forEach((s, i) => {
      const div = document.createElement("div");
      div.className = "seg" + (i === idx ? " active" : "");
      div.innerHTML = `
        <div class="t">${formatMMSS(s.durationMs)}</div>
        <div class="d">
          ${s.section ? `<div class="label" style="margin-bottom:4px;opacity:.75;">${escapeHtml(s.section)}</div>` : ""}
          ${escapeHtml(s.displayText)}
        </div>
      `;
      div.addEventListener("click", () => jumpTo(i));
      els.list.appendChild(div);
    });
  }

  function setButtonsEnabled(enabled) {
    els.playBtn.disabled = !enabled;
    els.prevBtn.disabled = !enabled;
    els.nextBtn.disabled = !enabled;
    els.resetBtn.disabled = !enabled;
    els.reloadBtn.disabled = !enabled;
  }

  function setRunning(on) {
    running = on;
    els.playBtn.textContent = running ? "Pause" : "Play";

    if (running) {
      lastTick = performance.now();
      lastSecondAnnounced = null;

      if (els.wakeLockToggle.checked) setWakeLock(true);
      requestAnimationFrame(tick);
    } else {
      setWakeLock(false);
    }
  }

  function describeCurrent() {
    if (!segments.length) return "Load a workout to begin.";
    const s = segments[idx];
    const prefix = s.section ? `${s.section} — ` : "";
    return prefix + s.displayText; // FULL LINE ✅
  }

  function updateUI() {
    if (!segments.length) {
      els.segmentDesc.textContent = "Load a workout to begin.";
      els.countdown.textContent = "00:00";
      els.metaLine.textContent = "";
      els.fill.style.width = "0%";
      els.posInfo.textContent = "—";
      els.totalInfo.textContent = "—";
      els.list.innerHTML = "";
      return;
    }

    const s = segments[idx];
    els.segmentDesc.textContent = describeCurrent();
    els.countdown.textContent = formatMMSS(segRemainingMs);
    els.metaLine.textContent = `Segment ${idx + 1}/${segments.length} • Segment length ${formatMMSS(s.durationMs)}`;

    const elapsedTotal = elapsedBeforeCurrentMs + (s.durationMs - segRemainingMs);
    const pct = totalMs > 0 ? (elapsedTotal / totalMs) * 100 : 0;
    els.fill.style.width = `${Math.min(100, Math.max(0, pct)).toFixed(2)}%`;

    els.posInfo.textContent = `Elapsed ${formatMMSS(elapsedTotal)} • Remaining ${formatMMSS(totalMs - elapsedTotal)}`;
    els.totalInfo.textContent = `Total ${formatMMSS(totalMs)}`;

    renderList();
  }

  function loadWorkout(fromText) {
    const text = (fromText ?? els.input.value) || "";
    try {
      segments = parseWorkout(text);
      idx = 0;
      totalMs = sumTotalMs(segments);
      elapsedBeforeCurrentMs = 0;
      segRemainingMs = segments[0].durationMs;

      setButtonsEnabled(true);
      setRunning(false);
      updateUI();

      saveState({ workoutText: text });
    } catch (e) {
      alert(e.message || String(e));
    }
  }

  function jumpTo(newIdx) {
    if (!segments.length) return;
    idx = Math.max(0, Math.min(segments.length - 1, newIdx));
    elapsedBeforeCurrentMs = computeElapsedBeforeIndex(segments, idx);
    segRemainingMs = segments[idx].durationMs;
    setRunning(false);
    updateUI();
  }

  function nextSegment() {
    if (!segments.length) return;
    if (idx < segments.length - 1) {
      idx++;
      elapsedBeforeCurrentMs = computeElapsedBeforeIndex(segments, idx);
      segRemainingMs = segments[idx].durationMs;
      lastSecondAnnounced = null;
      beep();
      vibrate([60, 40, 60]);
      updateUI();
    } else {
      // finished
      setRunning(false);
      segRemainingMs = 0;
      updateUI();
      beep(660, 180);
      vibrate([120, 60, 120]);
    }
  }

  function prevSegment() {
    if (!segments.length) return;
    if (idx > 0) {
      idx--;
      elapsedBeforeCurrentMs = computeElapsedBeforeIndex(segments, idx);
      segRemainingMs = segments[idx].durationMs;
      setRunning(false);
      updateUI();
    }
  }

  function resetWorkout() {
    if (!segments.length) return;
    idx = 0;
    elapsedBeforeCurrentMs = 0;
    segRemainingMs = segments[0].durationMs;
    setRunning(false);
    updateUI();
  }

  function tick(now) {
    if (!running) return;
    const dt = now - lastTick;
    lastTick = now;

    segRemainingMs -= dt;

    // Optional 3-2-1 countdown beeps in the last 3 seconds
    if (els.countdownBeepToggle.checked) {
      const sec = Math.max(0, Math.ceil(segRemainingMs / 1000));
      if (sec <= 3 && sec >= 1 && sec !== lastSecondAnnounced) {
        lastSecondAnnounced = sec;
        // Slightly different pitch each second
        const freq = sec === 3 ? 520 : (sec === 2 ? 620 : 720);
        beep(freq, 90);
        vibrate(40);
      }
    }

    if (segRemainingMs <= 0) {
      const overshoot = -segRemainingMs;
      nextSegment();
      if (running && segments.length && idx < segments.length) {
        segRemainingMs = Math.max(0, segRemainingMs - overshoot);
      }
    }

    updateUI();
    if (running) requestAnimationFrame(tick);
  }

  /** -------------------- Mode / Settings -------------------- **/
  function setWorkoutMode(on) {
    document.body.classList.toggle("workoutMode", on);
    els.modeToggle.checked = on;
    saveState({ workoutMode: on });
  }

  /** -------------------- Wire up -------------------- **/
  els.demoBtn.addEventListener("click", () => {
    els.input.value = DEMO;
    saveState({ workoutText: els.input.value });
  });

  els.loadBtn.addEventListener("click", () => loadWorkout());
  els.reloadBtn.addEventListener("click", () => loadWorkout());

  els.clearBtn.addEventListener("click", () => {
    els.input.value = "";
    saveState({ workoutText: "" });
  });

  els.playBtn.addEventListener("click", async () => {
    if (!segments.length) return;
    // On iOS, audio may require a user gesture; this click qualifies.
    setRunning(!running);
  });

  els.nextBtn.addEventListener("click", () => {
    setRunning(false);
    nextSegment();
  });

  els.prevBtn.addEventListener("click", () => prevSegment());
  els.resetBtn.addEventListener("click", () => resetWorkout());

  els.modeToggle.addEventListener("change", (e) => setWorkoutMode(e.target.checked));

  els.beepToggle.addEventListener("change", () => saveState({ beep: els.beepToggle.checked }));
  els.countdownBeepToggle.addEventListener("change", () => saveState({ countdownBeep: els.countdownBeepToggle.checked }));
  els.vibrateToggle.addEventListener("change", () => saveState({ vibrate: els.vibrateToggle.checked }));

  els.wakeLockToggle.addEventListener("change", async () => {
    saveState({ wakeLock: els.wakeLockToggle.checked });
    if (running) await setWakeLock(els.wakeLockToggle.checked);
  });

  // Autosave text as you type/paste
  let saveTimer = null;
  els.input.addEventListener("input", () => {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(() => saveState({ workoutText: els.input.value }), 250);
  });

  /** -------------------- Init from storage -------------------- **/
  const stored = loadState();

  els.input.value = typeof stored.workoutText === "string" && stored.workoutText.length
    ? stored.workoutText
    : DEMO;

  els.beepToggle.checked = stored.beep !== false; // default true
  els.countdownBeepToggle.checked = stored.countdownBeep === true; // default false
  els.vibrateToggle.checked = stored.vibrate !== false; // default true
  els.wakeLockToggle.checked = stored.wakeLock === true; // default false

  setWorkoutMode(stored.workoutMode === true);

  // Auto-load last workout so you can just hit Play
  loadWorkout(els.input.value);
})();
</script>
</body>
</html>
